<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="hr_employee_form_inherit_payroll_grade" model="ir.ui.view">
    <field name="name">hr.employee.form.inherit.payroll.grade</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">

      <!-- Add Grade near wage -->
      <xpath expr="//field[@name='wage']" position="before">
        <field name="grade"/>
      </xpath>

      <!-- Replace the original wage field with your related contract_wage -->
      <xpath expr="//field[@name='wage']" position="replace">
        <field name="contract_wage"/>
      </xpath>

    </field>
  </record>
</odoo>







